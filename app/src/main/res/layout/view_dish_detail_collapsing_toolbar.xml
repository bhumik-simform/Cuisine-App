<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.CollapsingToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/md_theme_light_background"
    app:contentScrim="@color/md_theme_light_surface"
    app:layout_scrollFlags="exitUntilCollapsed|scroll">

    <ImageView
        android:id="@+id/iv_dish_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_collapseMode="parallax"
        tools:src="@tools:sample/backgrounds/scenic" />

    <ImageView
        android:id="@+id/iv_back_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="15dp"
        android:layout_marginTop="17dp"
        android:background="@drawable/bg_circle_btn"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_backward"
        app:layout_collapseMode="pin"
        app:tint="@color/md_theme_light_onSurface" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/title_toolbar_dish_detail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        app:layout_collapseMode="pin"
        app:navigationIcon="@drawable/ic_arrow_backward"
        app:navigationIconTint="@color/md_theme_light_onSurface"
        app:title="Panner Butter Masala"
        app:titleCentered="true"
        app:titleTextAppearance="@style/CustomDishTitle" />

    <ImageView
        android:id="@+id/iv_fav_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bg_circle_btn"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_favorite_outlined"
        app:layout_collapseMode="pin" />

</com.google.android.material.appbar.CollapsingToolbarLayout>