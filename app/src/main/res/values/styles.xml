<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Style for unselected bottom navigation label -->
    <style name="BottomNavTextAppearance.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Style for Selected bottom navigation label -->
    <style name="BottomNavTextAppearance.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="RoundedCorner">
        <item name="cornerSize">16dp</item>
        <item name="cornerFamily">rounded</item>
    </style>
    
    <style name="CustomDishTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>

</resources>